@model AlMuhandisShop.Models.Purchase
@{
    ViewData["Title"] = $"فاتورة شراء #{Model.Id}";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-file-invoice me-2 text-primary"></i>فاتورة شراء رقم @Model.Id</h4>
    <div class="d-flex gap-2">
        <a asp-action="Return" asp-route-purchaseId="@Model.Id" class="btn btn-warning btn-sm">
            <i class="fas fa-undo me-1"></i> مرتجع
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-right me-1"></i> القائمة</a>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">بنود الفاتورة</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>#</th><th>المنتج</th><th>الكمية</th><th>السعر</th><th>الإجمالي</th></tr></thead>
                    <tbody>
                        @{int n = 1;}
                        @foreach (var item in Model.PurchaseItems)
                        {
                            <tr>
                                <td>@(n++)</td>
                                <td>@item.Product.Name</td>
                                <td>@item.Quantity.ToString("N3")</td>
                                <td>@item.UnitPrice.ToString("N2")</td>
                                <td>@item.Total.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr><td colspan="4" class="text-end">الإجمالي:</td><td>@Model.TotalAmount.ToString("N2")</td></tr>
                    </tfoot>
                </table>
            </div>
        </div>
        @if (Model.PurchaseReturns.Any())
        {
            <div class="card mt-3">
                <div class="card-header text-warning">المرتجعات</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>رقم</th><th>التاريخ</th><th>الإجمالي</th></tr></thead>
                        <tbody>
                            @foreach (var ret in Model.PurchaseReturns)
                            {
                                <tr>
                                    <td>@ret.Id</td>
                                    <td>@ret.Date.ToString("yyyy/MM/dd")</td>
                                    <td>@ret.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">ملخص الفاتورة</div>
            <div class="card-body">
                <table class="table table-borderless table-sm">
                    <tr><td>التاريخ:</td><td class="text-end">@Model.Date.ToString("yyyy/MM/dd")</td></tr>
                    <tr><td>المورد:</td><td class="text-end">@Model.Supplier.Name</td></tr>
                    <tr><td>الشركة:</td><td class="text-end">@Model.Supplier.CompanyName</td></tr>
                    <tr><td>طريقة الدفع:</td><td class="text-end">@Model.PaymentMethod.GetDisplayName()</td></tr>
                    <tr class="table-primary fw-bold">
                        <td>الإجمالي:</td><td class="text-end">@Model.TotalAmount.ToString("N2") ج.م</td>
                    </tr>
                    <tr><td>المدفوع:</td><td class="text-end text-success">@Model.PaidAmount.ToString("N2") ج.م</td></tr>
                    <tr class="@(Model.RemainingAmount > 0 ? "text-danger" : "text-success") fw-bold">
                        <td>المتبقي:</td><td class="text-end">@Model.RemainingAmount.ToString("N2") ج.م</td>
                    </tr>
                </table>
                @if (Model.RemainingAmount > 0)
                {
                    <a asp-controller="Suppliers" asp-action="Pay" asp-route-id="@Model.SupplierId"
                       class="btn btn-primary w-100 mt-2">
                        <i class="fas fa-money-bill-wave me-1"></i> دفع للمورد
                    </a>
                }
            </div>
        </div>
    </div>
</div>
