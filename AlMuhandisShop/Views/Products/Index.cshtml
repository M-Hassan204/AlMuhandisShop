@model IEnumerable<AlMuhandisShop.Models.Product>
@{
    ViewData["Title"] = "المنتجات";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-boxes me-2 text-success"></i>المنتجات</h4>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus me-1"></i>منتج جديد</a>
    }
</div>
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث باسم المنتج..." />
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">-- جميع الفئات --</option>
                    @foreach (var c in (ViewBag.Categories as SelectList)!)
                    {
                        <option value="@c.Value" selected="@(c.Selected)">@c.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check mt-2">
                    <input type="checkbox" name="lowStock" value="true" id="lowStock" class="form-check-input"
                           @(ViewBag.LowStock == true ? "checked" : "") />
                    <label for="lowStock" class="form-check-label">منخفض المخزون</label>
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">بحث</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إعادة تعيين</a>
            </div>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>المنتج</th>
                        <th>الفئة</th>
                        <th>سعر الشراء</th>
                        <th>سعر البيع</th>
                        <th>المخزون</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="@(!p.IsActive ? "table-secondary" : "")">
                            <td>
                                <a asp-action="Details" asp-route-id="@p.Id">@p.Name</a>
                                @if (!string.IsNullOrEmpty(p.Unit))
                                {
                                    <small class="text-muted ms-1">(@p.Unit)</small>
                                }
                            </td>
                            <td>@p.Category.Name</td>
                            <td>@p.PurchasePrice.ToString("N2")</td>
                            <td>@p.SellingPrice.ToString("N2")</td>
                            <td class="@(p.StockQuantity <= 5 ? "stock-low" : p.StockQuantity <= 10 ? "stock-warning" : "stock-ok")">
                                @p.StockQuantity.ToString("N3")
                            </td>
                            <td>
                                <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">
                                    @(p.IsActive ? "نشط" : "غير نشط")
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info btn-action"><i class="fas fa-eye"></i></a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary btn-action"><i class="fas fa-edit"></i></a>
                                    <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-warning" : "btn-outline-success") btn-action"
                                                data-confirm="@(p.IsActive ? "إيقاف المنتج؟" : "تفعيل المنتج؟")">
                                            <i class="fas fa-@(p.IsActive ? "toggle-on" : "toggle-off")"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state"><i class="fas fa-boxes"></i><p>لا توجد منتجات</p></div>
        }
    </div>
</div>
