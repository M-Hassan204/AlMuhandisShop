@model AlMuhandisShop.ViewModels.ExpensesReportViewModel
@{ ViewData["Title"] = "تقرير المصاريف"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-receipt me-2 text-warning"></i>تقرير المصاريف</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-right me-1"></i> التقارير</a>
</div>
<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label small">من تاريخ</label><input name="fromDate" type="date" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control"/></div>
        <div class="col-md-4"><label class="form-label small">إلى تاريخ</label><input name="toDate" type="date" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control"/></div>
        <div class="col-md-4"><button type="submit" class="btn btn-primary mt-4">بحث</button></div>
    </form>
</div></div>
<div class="alert alert-warning"><strong>إجمالي المصاريف: @Model.TotalExpenses.ToString("N2") ج.م</strong></div>
<div class="card"><div class="card-body p-0">
    @if (Model.Expenses.Any())
    {
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>البيان</th><th>التاريخ</th><th>المبلغ</th><th>ملاحظات</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Expenses)
                {
                    <tr>
                        <td>@e.Id</td>
                        <td>@e.Name</td>
                        <td>@e.Date.ToString("yyyy/MM/dd")</td>
                        <td class="fw-bold text-danger">@e.Amount.ToString("N2") ج.م</td>
                        <td>@e.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else { <div class="empty-state"><i class="fas fa-receipt"></i><p>لا توجد مصاريف</p></div> }
</div></div>
