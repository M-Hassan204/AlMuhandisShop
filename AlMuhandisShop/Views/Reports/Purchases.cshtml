@model AlMuhandisShop.ViewModels.PurchasesReportViewModel
@{ ViewData["Title"] = "تقرير المشتريات"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-truck me-2 text-primary"></i>تقرير المشتريات</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-right me-1"></i> التقارير</a>
</div>
<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label small">من تاريخ</label><input name="fromDate" type="date" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control"/></div>
        <div class="col-md-4"><label class="form-label small">إلى تاريخ</label><input name="toDate" type="date" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control"/></div>
        <div class="col-md-4"><button type="submit" class="btn btn-primary mt-4">بحث</button> <a asp-action="Purchases" class="btn btn-outline-secondary mt-4">كل التواريخ</a></div>
    </form>
</div></div>
<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="stat-card stat-blue"><div class="stat-title">إجمالي المشتريات</div><div class="stat-value">@Model.TotalPurchases.ToString("N0")</div><div class="stat-icon"><i class="fas fa-truck"></i></div></div></div>
    <div class="col-md-4"><div class="stat-card stat-green"><div class="stat-title">إجمالي المدفوع</div><div class="stat-value">@Model.TotalPaid.ToString("N0")</div><div class="stat-icon"><i class="fas fa-check-circle"></i></div></div></div>
    <div class="col-md-4"><div class="stat-card stat-red"><div class="stat-title">إجمالي المتبقي</div><div class="stat-value">@Model.TotalRemaining.ToString("N0")</div><div class="stat-icon"><i class="fas fa-clock"></i></div></div></div>
</div>
<div class="card"><div class="card-body p-0">
    @if (Model.Purchases.Any())
    {
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>التاريخ</th><th>المورد</th><th>الإجمالي</th><th>المدفوع</th><th>المتبقي</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Purchases)
                {
                    <tr>
                        <td><a asp-controller="Purchases" asp-action="Details" asp-route-id="@p.Id">@p.Id</a></td>
                        <td>@p.Date.ToString("yyyy/MM/dd")</td>
                        <td>@p.Supplier.Name</td>
                        <td>@p.TotalAmount.ToString("N2")</td>
                        <td>@p.PaidAmount.ToString("N2")</td>
                        <td class="@(p.RemainingAmount > 0 ? "text-danger" : "")">@p.RemainingAmount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else { <div class="empty-state"><i class="fas fa-truck"></i><p>لا توجد مشتريات</p></div> }
</div></div>
