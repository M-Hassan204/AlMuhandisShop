@{ ViewData["Title"] = "ديون الموردين"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-industry me-2 text-danger"></i>ديون الموردين</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-right me-1"></i> التقارير</a>
</div>
<div class="alert alert-danger"><strong>إجمالي ديون الموردين: @((decimal)ViewBag.TotalDebt).ToString("N2") ج.م</strong></div>
<div class="card"><div class="card-body p-0">
    @{
        var debts = ViewBag.SupplierDebts as List<(AlMuhandisShop.Models.Supplier Supplier, decimal Balance)>;
    }
    @if (debts != null && debts.Any())
    {
        <table class="table table-hover mb-0">
            <thead><tr><th>المورد</th><th>الشركة</th><th>الهاتف</th><th>الرصيد المستحق</th><th>إجراءات</th></tr></thead>
            <tbody>
                @foreach (var (supplier, balance) in debts)
                {
                    <tr>
                        <td><a asp-controller="Suppliers" asp-action="Details" asp-route-id="@supplier.Id">@supplier.Name</a></td>
                        <td>@supplier.CompanyName</td>
                        <td>@supplier.Phone</td>
                        <td class="fw-bold text-danger">@balance.ToString("N2") ج.م</td>
                        <td><a asp-controller="Suppliers" asp-action="Pay" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-money-bill-wave me-1"></i>دفع</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else { <div class="empty-state"><i class="fas fa-check-circle text-success"></i><p class="text-success">لا توجد ديون للموردين!</p></div> }
</div></div>
