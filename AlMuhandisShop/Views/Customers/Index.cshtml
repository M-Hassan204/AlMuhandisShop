@model IEnumerable<AlMuhandisShop.Models.Customer>
@{ ViewData["Title"] = "العملاء"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-users me-2"></i>العملاء</h4>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus me-1"></i>عميل جديد</a>
</div>
<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2">
        <div class="col-md-8">
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث بالاسم أو الهاتف..." />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">بحث</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إعادة تعيين</a>
        </div>
    </form>
</div></div>
<div class="card"><div class="card-body p-0">
    @if (Model.Any())
    {
        <table class="table table-hover mb-0">
            <thead><tr><th>العميل</th><th>الهاتف</th><th>العنوان</th><th>الحالة</th><th>إجراءات</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr class="@(!c.IsActive ? "table-secondary" : "")">
                        <td><a asp-action="Details" asp-route-id="@c.Id">@c.Name</a></td>
                        <td>@c.Phone</td>
                        <td>@c.Address</td>
                        <td><span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "نشط" : "غير نشط")</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info btn-action"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary btn-action"><i class="fas fa-edit"></i></a>
                            <a asp-action="Pay" asp-route-id="@c.Id" class="btn btn-sm btn-outline-success btn-action"><i class="fas fa-money-bill-wave"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else { <div class="empty-state"><i class="fas fa-users"></i><p>لا يوجد عملاء</p></div> }
</div></div>
