@model AlMuhandisShop.Models.Customer
@{ ViewData["Title"] = "تعديل عميل"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-edit me-2"></i>تعديل: @Model.Name</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-right me-1"></i> القائمة</a>
</div>
<div class="card"><div class="card-body">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id"/>
        <input type="hidden" asp-for="CreatedAt"/>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"/></div>
            <div class="col-md-6"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control"/></div>
            <div class="col-md-6"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
            <div class="col-md-3"><div class="form-check mt-3"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">نشط</label></div></div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> تحديث</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">إلغاء</a>
        </div>
    </form>
</div></div>
