@model AlMuhandisShop.Models.Expense
@{ ViewData["Title"] = "تعديل مصروف"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-edit me-2"></i>تعديل مصروف</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-right me-1"></i> القائمة</a>
</div>
<div class="row justify-content-center"><div class="col-md-6">
<div class="card"><div class="card-body">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id"/>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/></div>
        <div class="mb-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control"/></div>
        <div class="mb-3"><label asp-for="Date" class="form-label"></label><input asp-for="Date" type="datetime-local" class="form-control"/></div>
        <div class="mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> تحديث</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">إلغاء</a>
    </form>
</div></div>
</div></div>
