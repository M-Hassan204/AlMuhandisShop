@model AlMuhandisShop.ViewModels.CreateSaleViewModel
@{
    ViewData["Title"] = "فاتورة بيع جديدة";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-shopping-cart me-2 text-success"></i>فاتورة بيع جديدة</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-right me-1"></i> العودة للقائمة
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]</div>
}

<form id="saleForm" asp-action="Create" method="post">
    <div class="row g-3">
        <!-- Header -->
        <div class="col-md-8">
            <div class="invoice-section">
                <h6 class="fw-bold mb-3 text-success">بيانات الفاتورة</h6>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">العميل (اختياري)</label>
                        <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
                            <option value="">-- بيع نقدي --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Date" class="form-label">التاريخ</label>
                        <input asp-for="Date" type="datetime-local" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PaymentMethod" class="form-label">طريقة الدفع</label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="1">نقدي</option>
                            <option value="2">تحويل بنكي</option>
                            <option value="3">شيك</option>
                            <option value="4">آجل</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">ملاحظات</label>
                        <input asp-for="Notes" class="form-control" placeholder="ملاحظات اختيارية..." />
                    </div>
                </div>
            </div>

            <!-- Products Section -->
            <div class="invoice-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0 text-success">المنتجات</h6>
                    <button type="button" id="addItem" class="btn btn-sm btn-success">
                        <i class="fas fa-plus me-1"></i> إضافة منتج
                    </button>
                </div>

                <div id="itemsContainer">
                    <!-- Items added by JS -->
                </div>

                <div id="emptyMsg" class="text-center text-muted py-3">
                    <i class="fas fa-plus-circle fs-2 mb-2 d-block text-muted"></i>
                    أضف منتجات للفاتورة
                </div>

                <!-- Products dropdown for selection -->
                <div class="mt-2">
                    <select id="productSelect" class="form-select">
                        <option value="">-- اختر منتجًا للإضافة --</option>
                        @foreach (var item in Model.Products!)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Totals -->
        <div class="col-md-4">
            <div class="invoice-section">
                <h6 class="fw-bold mb-3 text-success">ملخص الفاتورة</h6>
                <div class="totals-box">
                    <div class="d-flex justify-content-between mb-2">
                        <span>إجمالي الفاتورة:</span>
                        <strong id="totalDisplay">0.00 ج.م</strong>
                    </div>
                    <hr class="my-2"/>
                    <div class="mb-2">
                        <label class="form-label fw-bold">المبلغ المدفوع</label>
                        <input asp-for="PaidAmount" id="paidAmount" type="number" step="0.01" min="0"
                               class="form-control" oninput="calcRemaining()" />
                        <span asp-validation-for="PaidAmount" class="text-danger small"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>المبلغ المتبقي:</span>
                        <strong id="remainingDisplay" class="text-danger">0.00 ج.م</strong>
                    </div>
                </div>

                <button type="submit" class="btn btn-success w-100 mt-3 py-2 fw-bold" id="submitBtn" disabled>
                    <i class="fas fa-save me-2"></i> حفظ الفاتورة
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
let itemCount = 0;
const products = {};

// Load product info via AJAX
async function getProductInfo(id) {
    if (products[id]) return products[id];
    const res = await fetch(`/Products/GetPrice?id=${id}`);
    if (res.ok) {
        products[id] = await res.json();
    }
    return products[id];
}

document.getElementById('addItem').addEventListener('click', async function() {
    const select = document.getElementById('productSelect');
    const productId = select.value;
    if (!productId) {
        alert('اختر منتجًا أولاً');
        return;
    }
    const info = await getProductInfo(productId);
    if (!info) return;

    const productName = select.options[select.selectedIndex].text;
    addItemRow(productId, productName, info.price, info.stock, info.unit);
    select.value = '';
});

function addItemRow(productId, productName, price, stock, unit) {
    const container = document.getElementById('itemsContainer');
    const emptyMsg = document.getElementById('emptyMsg');
    emptyMsg.style.display = 'none';
    document.getElementById('submitBtn').disabled = false;

    const i = itemCount++;
    const row = document.createElement('div');
    row.className = 'item-row mb-2';
    row.id = `row-${i}`;
    row.innerHTML = `
        <input type="hidden" name="Items[${i}].ProductId" value="${productId}" />
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small text-muted">المنتج</label>
                <div class="fw-bold">${productName}</div>
                <small class="text-muted">متاح: <span class="stock-ok">${stock} ${unit || ''}</span></small>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">الكمية</label>
                <input type="number" name="Items[${i}].Quantity" class="form-control qty-input"
                       step="0.001" min="0.001" max="${stock}" value="1"
                       data-price="${price}" data-row="${i}"
                       oninput="calcLine(${i})" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">السعر</label>
                <div class="fw-bold text-primary">${parseFloat(price).toFixed(2)}</div>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">الإجمالي</label>
                <div class="fw-bold text-success" id="line-${i}">${parseFloat(price).toFixed(2)}</div>
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-sm btn-outline-danger mt-3"
                        onclick="removeRow(${i})"><i class="fas fa-trash"></i></button>
            </div>
        </div>
    `;
    container.appendChild(row);
    calcTotal();
}

function calcLine(i) {
    const qtyInput = document.querySelector(`[data-row="${i}"]`);
    if (!qtyInput) return;
    const qty = parseFloat(qtyInput.value) || 0;
    const price = parseFloat(qtyInput.dataset.price) || 0;
    const total = qty * price;
    document.getElementById(`line-${i}`).textContent = total.toFixed(2);
    calcTotal();
}

function calcTotal() {
    let total = 0;
    document.querySelectorAll('.qty-input').forEach(inp => {
        const qty = parseFloat(inp.value) || 0;
        const price = parseFloat(inp.dataset.price) || 0;
        total += qty * price;
    });
    document.getElementById('totalDisplay').textContent = total.toFixed(2) + ' ج.م';
    calcRemaining();
}

function calcRemaining() {
    const totalText = document.getElementById('totalDisplay').textContent.replace(' ج.م', '');
    const total = parseFloat(totalText) || 0;
    const paid = parseFloat(document.getElementById('paidAmount').value) || 0;
    const remaining = Math.max(0, total - paid);
    document.getElementById('remainingDisplay').textContent = remaining.toFixed(2) + ' ج.م';
}

function removeRow(i) {
    const row = document.getElementById(`row-${i}`);
    if (row) row.remove();
    // Re-check if any rows remain
    if (document.querySelectorAll('.item-row').length === 0) {
        document.getElementById('emptyMsg').style.display = 'block';
        document.getElementById('submitBtn').disabled = true;
    }
    calcTotal();
}
</script>
}
